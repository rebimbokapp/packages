{
  "name": "@hitechline/rebimboka-database",
  "version": "0.1.1",
  "license": "UNLICENSED",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "typings/index.d.ts",
  "exports": {
    "./prisma/postgres": "./dist/prisma/postgres/index.js",
    "./prisma/mongo": "./dist/prisma/mongo/index.js"
  },
  "typesVersions": {
    "*": {
      "prisma/postgres": [
        "typings/prisma/postgres/index.d.ts"
      ],
      "prisma/mongo": [
        "typings/prisma/mongo/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "prisma",
    "typings",
    "package.json"
  ],
  "repository": {
    "type": "git",
    "directory": "packages/database",
    "url": "git+https://github.com/hitechline/hitl-rbk-packages.git"
  },
  "scripts": {
    "prepare": "run-s \"generate:{postgres,mongo}\"",
    "clean": "rimraf dist prisma/postgres/generated prisma/mongo/generated typings",
    "migrate:postgres:dev": "npx prisma migrate dev --schema prisma/postgres/schema.prisma",
    "migrate:mongo:dev": "npx prisma migrate dev --schema prisma/mongo/schema.prisma",
    "migrate:postgres:prod": "npx prisma migrate deploy --schema prisma/postgres/schema.prisma",
    "migrate:mongo:prod": "npx prisma migrate deploy --schema prisma/mongo/schema.prisma",
    "studio": "npx prisma studio",
    "generate:postgres": "npx prisma generate --schema prisma/postgres/schema.prisma",
    "generate:mongo": "npx prisma generate --schema prisma/mongo/schema.prisma",
    "build": "run-s clean \"generate:{postgres,mongo}\" \"build:{types,files}\"",
    "build:types": "tsc --project tsconfig.types.json",
    "build:files": "node esbuild.config.js"
  },
  "dependencies": {
    "@prisma/client": "4.15.0"
  },
  "devDependencies": {
    "prisma": "4.15.0"
  }
}
